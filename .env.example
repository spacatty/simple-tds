# Copy to .env and change the passwords before the first start.
POSTGRES_PASSWORD=change-me
CLICKHOUSE_PASSWORD=change-me

# Panel login created on first start. Leave the password empty to have a
# random one printed once in `docker compose logs tds`.
TDS_ADMIN_USER=admin
TDS_ADMIN_PASSWORD=

# Host port of the ip:port panel.
PANEL_PORT=8080

# Set to 1 to keep ip:port panel access on even if it was disabled in Settings.
TDS_FORCE_PANEL_IP=

# Address shown in the panel's DNS hint. Detected automatically when empty.
TDS_PUBLIC_IP=
