# Copy to .env and change the passwords before the first start.
POSTGRES_PASSWORD=change-me
CLICKHOUSE_PASSWORD=change-me

# Where the container's ports are published on the host: PORT or IP:PORT.
# Behind another web server that already owns 80/443 (nginx, OpenResty,
# 1Panel), publish on loopback instead and proxy to it, e.g.
#   HTTP_BIND=127.0.0.1:8081
#   HTTPS_BIND=127.0.0.1:8443
HTTP_BIND=80
HTTPS_BIND=443
PANEL_BIND=8080

# Set to 1 to keep ip:port panel access on even if it was disabled in Settings.
TDS_FORCE_PANEL_IP=

# Address shown in the panel's DNS hint. Detected automatically when empty.
TDS_PUBLIC_IP=

# Resolver the reputation checks ask the DNS blocklists (Spamhaus, SURBL,
# URIBL) through, as host or host:port. Leave commented out to use the bundled
# unbound container; set it empty to use the system resolver instead.
#TDS_BLOCKLIST_DNS=
